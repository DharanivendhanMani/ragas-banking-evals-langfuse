# Generation (Groq, OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings + Ragas judge (Google Gemini, OpenAI-compatible endpoint)
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
JUDGE_MODEL=gemini-flash-lite-latest

# Langfuse Cloud (EU: cloud.langfuse.com, US: us.cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
